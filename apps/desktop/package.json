{
  "name": "@focusnotes/desktop",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "description": "跨平台智能待办便笺",
  "author": "FocusNotes",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron --inspect=127.0.0.1:9229 .\"",
    "start": "electron .",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@focusnotes/core": "1.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.focusnotes.desktop",
    "productName": "FocusNotes",
    "directories": { "output": "release-230b" },
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "electronLanguages": ["zh-CN", "en-US"],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*",
      "!**/*.map",
      "!**/*.md"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "electron/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "FocusNotes",
      "artifactName": "FocusNotes-Setup-${version}.${ext}"
    }
  }
}
