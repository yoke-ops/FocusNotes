<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_square_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="待办"
        android:textColor="#6e6e73"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_square_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="暂无待办"
        android:textColor="#6e6e73"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/widget_square_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_sq_1"
            style="@style/WidgetSquareRow" />
        <TextView
            android:id="@+id/widget_sq_2"
            style="@style/WidgetSquareRow" />
        <TextView
            android:id="@+id/widget_sq_3"
            style="@style/WidgetSquareRow" />
    </LinearLayout>
</LinearLayout>
